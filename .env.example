# Copy to .env for local use. NEVER commit the real .env file.
# The API key is read from the environment only; it is deliberately NOT a command-line option,
# because command-line arguments end up in shell history and in `ps` output.

# Where sentinel-api is running
SENTINEL_API_URL=http://localhost:4000

# An API key created in the dashboard / API (needs the scopes: events:write, scans:write, incidents:read)
SENTINEL_API_KEY=

# Politeness: seconds to wait between requests to a target, and per-request timeout
SENTINEL_REQUEST_DELAY=0.5
SENTINEL_TIMEOUT=10
